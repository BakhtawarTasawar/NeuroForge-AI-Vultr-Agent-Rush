
# ============================================================
# NEUROFORGE AI
# ROOT ENVIRONMENT TEMPLATE
# ============================================================
# This file contains placeholders only.
# Never put actual API keys, passwords or JWT secrets here.
#
# Actual backend secrets belong in:
# backend/.env
#
# Frontend configuration belongs in:
# frontend/.env.local
# ============================================================


# ============================================================
# BACKEND APPLICATION
# ============================================================

APP_ENV=development
APP_PORT=8020
HOST=127.0.0.1

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]


# ============================================================
# POSTGRESQL DATABASE
# Existing NeuroForge Docker PostgreSQL container
# ============================================================

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
POSTGRES_DB=neuroforge
POSTGRES_USER=neuroforge_app

# Replace with the EXISTING application-role password.
POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_APP_PASSWORD

# SQLAlchemy application database URL
DATABASE_URL=postgresql+psycopg://neuroforge_app:REPLACE_WITH_EXISTING_APP_PASSWORD@127.0.0.1:5440/neuroforge

# LangGraph checkpoint persistence
CHECKPOINT_DATABASE_URL=postgresql://neuroforge_app:REPLACE_WITH_EXISTING_APP_PASSWORD@127.0.0.1:5440/neuroforge


# ============================================================
# AUTHENTICATION AND SECURITY
# ============================================================

# Generate a new random secret locally.
JWT_SECRET_KEY=REPLACE_WITH_NEW_RANDOM_SECRET

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local HTTP development only.
# Set true in HTTPS production deployment.
COOKIE_SECURE=false


# ============================================================
# VULTR SERVERLESS INFERENCE
# ============================================================

VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Never commit a real key.
VULTR_INFERENCE_API_KEY=REPLACE_WITH_VULTR_INFERENCE_API_KEY

VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017

VULTR_INFERENCE_TIMEOUT_SECONDS=45
VULTR_INFERENCE_MAX_RETRIES=3
VULTR_INFERENCE_MAX_TOKENS=2048
VULTR_INFERENCE_TEMPERATURE=0.2


# ============================================================
# DOCKER SCIENTIFIC EXECUTION SANDBOX
# ============================================================

SANDBOX_IMAGE=neuroforge-sandbox:local
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT=1024m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=64

# DOCKER_GID — host Docker group GID required for appuser to access /var/run/docker.sock
# On the Vultr host, obtain it with: getent group docker | cut -d: -f3
# Example: DOCKER_GID=998
DOCKER_GID=REPLACE_WITH_HOST_DOCKER_GROUP_GID


# ============================================================
# FRONTEND REFERENCE
# Do not put backend secrets in frontend environment variables.
# ============================================================

# Configure separately in frontend/.env.local:
# VITE_API_BASE_URL=http://127.0.0.1:8020
